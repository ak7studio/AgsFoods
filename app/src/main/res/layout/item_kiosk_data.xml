<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="4dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Morning Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Morning" android:textStyle="bold"/>
                <TextView  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvMorningSales" android:text="Sales: -" />
                <TextView  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvMorningExpenses" android:text="Expenses: -" />
            </LinearLayout>

            <!-- Evening Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Evening" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvEveningSales" android:text="Sales: -" />
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvEveningExpenses" android:text="Expenses: -" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


</androidx.cardview.widget.CardView>
